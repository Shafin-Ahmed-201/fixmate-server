# --- Server ---
PORT=5000
CLIENT_URL=http://localhost:3000

# --- MongoDB (same database the Next.js client uses) ---
MONGODB_URI=mongodb://<user>:<password>@<cluster-host>:27017/?ssl=true&replicaSet=<rs>&authSource=admin
DB_NAME=fixmateDB

# --- BetterAuth JWT bridge ---
# Must match BETTER_AUTH_SECRET of the client app (HS256 fallback tokens).
BETTER_AUTH_SECRET=change-me
# Where BetterAuth is served (Next.js). JWKS is derived from this when
# AUTH_JWKS_URL is not set: <AUTH_BASE_URL>/api/auth/jwks
AUTH_BASE_URL=http://localhost:3000
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:5000/api/webhook/stripe`
# or the webhook endpoint secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
